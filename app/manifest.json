{
	"manifest_version": 3,

	"name": "__MSG_name__",
	"description": "__MSG_description__",
	"version": "1.19",

	"minimum_chrome_version": "88.0",

	"default_locale": "en",

	"permissions": [
		"bookmarks",
		"contextMenus",
		"favicon",
		"storage",
		"tabs",
		"clipboardWrite",

		"topSites"
	],

	"icons": {
		"16": "img/z_16x16.png",
		"32": "img/z_32x32.png",
		"48": "img/z_48x48.png",
		"128": "img/z_128x128.png"
	},

	"background": {
		"service_worker": "js/background.js"
	},

	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},


	"chrome_url_overrides":	{
		"newtab": "newtab.html"
	},

	"web_accessible_resources": [{
		"resources": [ "img/*.png", "newtab.html" ],
		"matches": ["<all_urls>"]
	}],

	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'"
	},

	"content_scripts": [
		{
			"matches": [ "\u003Call_urls\u003E" ],
			"js": [
				"js/enums.js",
				"js/utilities.js",
				"js/eventmanager.js",
				"js/defaultoptions.js",
				"js/gesture.js",
				"js/mousegesture.js",
				"js/rockergesture.js",
				"js/gestures.js",
				"js/contentactions.js",
				"js/handler.js",
				"js/content.js"
			],
			"run_at": "document_start",
			"all_frames": true
		}
	]
}
